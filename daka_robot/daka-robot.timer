[Unit]
Description=Export DAKA every hour from 06:00 to 22:00 Hong Kong time

[Timer]
# The container clock is UTC. 06:00–22:00 Hong Kong is 22:00–14:00 UTC.
OnCalendar=*-*-* 00..14:00:00
OnCalendar=*-*-* 22..23:00:00
AccuracySec=1min
Persistent=true
Unit=daka-robot.service

[Install]
WantedBy=timers.target
