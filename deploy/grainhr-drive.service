[Unit]
Description=GrainHR shared-drive mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=app
Group=app
Environment=HOME=/home/app
ExecStart=/usr/bin/rclone mount grainhr: /srv/grainhr/hr --vfs-cache-mode full --dir-cache-time 1000h --poll-interval 30s --vfs-cache-max-age 720h --vfs-cache-max-size 5G
ExecStop=/bin/fusermount -u /srv/grainhr/hr
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
